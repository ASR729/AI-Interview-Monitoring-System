# Environment Configuration
# Copy this file to .env and update values as needed

# Application
NODE_ENV=development
PORT=3001

# CORS - Frontend origin for local development
# The e2b preview origin is the pinned public frontend URL (never change the port/link)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180,https://5180-iteaxs65egwgp2h9q52q5.e2b.app

# Database - MongoDB (Phase 5)
# Local MongoDB Community Server is the approved development database.
# MONGODB_URI may include credentials for authenticated instances; never
# commit real credentials. The URI below is a local placeholder.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=interview_monitoring

# Authentication - NOT USED IN PHASE 3
# Will be configured in Phase 6 (Authentication & RBAC)
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRES_IN=24h

# AI Service - NOT USED IN PHASE 3
# Will be configured in Phase 4 (Python/FastAPI AI Service)
# AI_SERVICE_URL=http://localhost:8000

# Logging
LOG_LEVEL=dev
