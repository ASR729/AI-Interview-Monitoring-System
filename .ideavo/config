{
  "systemSetup": [],
  "templateName": "custom",
  "projectDependencies": [
    { "name": "Install Frontend Dependencies", "command": "npm install --prefix frontend" },
    { "name": "Install Backend Dependencies", "command": "npm install --prefix backend" }
  ],
  "codeChecks": [
    { "name": "Lint Frontend", "command": "npm run lint --prefix frontend" },
    { "name": "Test Backend", "command": "npm test --prefix backend" }
  ],
  "buildSteps": [
    { "name": "Build Frontend", "command": "npm run build --prefix frontend" }
  ],
  "runStep": [
    { "name": "Run Backend Server", "command": "npm run dev --prefix backend -- --port 3001", "port": "3001" },
    { "name": "Run Frontend Dev Server", "command": "npm run dev --prefix frontend -- --port 5173 --host", "port": "5173" }
  ],
  "deploySteps": [
    { "name": "Build Frontend", "command": "npm run build --prefix frontend" }
  ],
  "cleanupFiles": [
    "frontend/node_modules",
    "backend/node_modules",
    "frontend/dist",
    "backend/.env"
  ],
  "packageManager": "npm",
  "envPaths": [
    { "name": "backend", "path": "backend/.env" }
  ]
}
